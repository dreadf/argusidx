# data/raw/ holds PURCHASED Sectors API data (real credits spent). Sectors' terms do
# not allow republishing it, so it lives in the private repository
# dreadf/argusidx-data and is ignored here. Never delete it locally: it cannot be
# re-fetched without spending credits. Copy it back into data/raw/ after a clone.
data/raw/

# Yahoo dev-time cache: free and re-fetchable, safe to ignore.
data/dev_cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Env / secrets
.env
.env.local
*.key

# Vercel: local project link (org/project IDs, not secret, but
# machine-specific and not meant to be committed).
.vercel

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Claude Code: machine-specific settings (absolute paths). CLAUDE.md itself
# IS committed -- it carries the project rules.
.claude/settings.local.json

# Agent worktrees (local isolation copies)
.claude/worktrees/

# Development and planning files: kept locally, not part of the submission.
/RULES.md
/CLAUDE.md
/BACKLOG.md
/docs/PLAN.md
/docs/PRODUCT.md
/docs/SUBMISSION.md
/.claude/
/frontend/CLAUDE.md
/frontend/AGENTS.md
# Background research reports and their source notes: not part of the product,
# and the notes may quote third-party articles.
/reports/
/research_notes/
.env*
